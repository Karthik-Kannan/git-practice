<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReceiptSnap">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ReceiptSnap.Camera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReceiptsActivity"
            android:exported="false"
            android:label="@string/saved_receipts"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.ReceiptSnap.Bar" />

        <activity
            android:name=".ReceiptDetailActivity"
            android:exported="false"
            android:label="@string/receipt"
            android:parentActivityName=".ReceiptsActivity"
            android:theme="@style/Theme.ReceiptSnap.Bar" />

        <activity
            android:name=".CropProbeActivity"
            android:exported="false"
            android:label="@string/probe_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.ReceiptSnap.Bar" />

    </application>

</manifest>
